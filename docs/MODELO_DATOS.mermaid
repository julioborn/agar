        float cantidad_aplicada
        float cantidad_devuelta
        float costo_unitario_ars_momento
        float costo_imputado_ars
    }

    DEVOLUCIONES_STOCK {
        int id PK
        int aplicacion_item_id FK
        date fecha
        float cantidad
        int deposito_destino_id FK
        int usuario_id FK
        string observaciones
    }

    MERMAS {
        int id PK
