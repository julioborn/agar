    EMPRESAS {
        int id PK
        string nombre
        string cuit
        string datos_fiscales
        datetime fecha_alta
        string subdominio
        string logo_url
        string moneda_base
    }

    UNIDADES_NEGOCIO {
        int id PK
        int empresa_id FK
        string nombre
        string tipo
        string descripcion
        boolean activa
    }

    USUARIOS {
        int id PK
        string nombre
        string email UK
        string password_hash
        string telefono
    }

    USUARIOS_EMPRESAS {
        int id PK
        int usuario_id FK
        int empresa_id FK
        string rol
        int campo_id_asignado FK
    }

    OPERARIOS {
        int id PK
        int empresa_id FK
        string nombre
        string dni
        string telefono
        string categoria
        float valor_hora_ars
        int usuario_id FK
        boolean activo
    }

    CAMPOS {
        int id PK
        int empresa_id FK
        string nombre
        float lat
        float lng
        float hectareas_totales
    }

    LOTES {
        int id PK
        int campo_id FK
        string nombre
        float hectareas
        json poligono
    }

    CAMPANIAS {
        int id PK
        int lote_id FK
        int unidad_negocio_id FK
        string cultivo
        date fecha_siembra
        date fecha_cosecha_estimada
        date fecha_cosecha_real
        string estado
        float produccion_total_kg
        float rendimiento_kg_ha
        float precio_referencia_ars_kg
        float ingreso_bruto_ars
        float costo_directo_ars
        float costo_mermas_ars
        float margen_bruto_ars
        float margen_bruto_ars_ha
        float desvio_costo_vs_plan
        float desvio_rinde_vs_plan
    }

    PLANES_CAMPANIA {
        int id PK
        int campania_id FK
        int presupuesto_siembra_id FK
        date fecha_plan
        float rinde_esperado_kg_ha
        float precio_esperado_ars_kg
        float costo_presupuestado_ars
        float ingreso_esperado_ars
        float margen_esperado_ars
        float margen_esperado_ars_ha
        float punto_equilibrio_kg_ha
        float punto_equilibrio_precio_ars
        string estado
        int creado_por FK
        string observaciones
    }

    PLANES_CAMPANIA_ITEMS {
        int id PK
        int plan_campania_id FK
        string tipo_item
        int producto_id FK
        string descripcion
        float cantidad_prevista
        string unidad
        float costo_unitario_previsto_ars
        float costo_total_previsto_ars
        date fecha_prevista
    }

    PRESUPUESTOS_SIEMBRA {
        int id PK
        int empresa_id FK
        string nombre
        string cultivo
        string zona
        json items_plantilla
        float rinde_objetivo_kg_ha
        int creado_por FK
        datetime fecha_creacion
        boolean activo
        string observaciones
    }

    ANALISIS_SENSIBILIDAD {
        int id PK
        int campania_id FK
        string nombre_escenario
        datetime fecha
        float variacion_precio_pct
        float variacion_dolar_pct
        float variacion_rinde_pct
        float variacion_costos_pct
        float margen_resultante_ars
        float margen_resultante_ars_ha
        json detalle_calculo
        int creado_por FK
    }

    COSECHAS {
        int id PK
        int campania_id FK
        date fecha
        float cantidad
        string unidad_medida
        float cantidad_kg
        float humedad_porcentaje
        string destino_inicial
        string observaciones
    }

    DESTINOS_PRODUCCION {
        int id PK
        int campania_id FK
        date fecha
        string tipo_destino
        float cantidad_kg
        int unidad_negocio_destino_id FK
        string comprador_externo
        int precio_referencia_id FK
        string moneda
        float cotizacion_usd
        float precio_unitario_moneda_original
        float precio_unitario_ars_kg
        float total_ars
        string numero_factura
        string archivo_factura_url
        string observaciones
    }

    PRECIOS_REFERENCIA {
        int id PK
        int empresa_id FK
        date fecha
        string cultivo
        string mercado
        string moneda
        float precio_unitario
        float precio_unitario_ars_kg
        string fuente
        string observaciones
    }

    PRODUCTOS {
        int id PK
        int empresa_id FK
        string nombre
        string categoria
        string unidad_base
        string codigo_barras
        string codigo_interno
        string principio_activo
        float stock_minimo
        boolean requiere_trazabilidad
    }

    PRESENTACIONES {
        int id PK
        int producto_id FK
        string descripcion
        float factor_a_unidad_base
    }

    PARTIDAS_PRODUCTO {
        int id PK
        int producto_id FK
        int compra_item_id FK
        string numero_lote_proveedor
        date fecha_vencimiento
        float cantidad_inicial
        float cantidad_actual
        float costo_unitario_ars
        datetime fecha_alta
        string estado
    }

    CONSUMOS_PARTIDA {
        int id PK
        int partida_id FK
        int aplicacion_item_id FK
        int labor_material_id FK
        float cantidad_consumida
        datetime fecha
        string motivo
    }

    PROVEEDORES {
        int id PK
        int empresa_id FK
        string nombre
        string cuit
        string contacto
    }

    CONTRATISTAS {
        int id PK
        int empresa_id FK
        string nombre
        string cuit
        string contacto
        json tipos_servicio
        string zona_trabajo
        string observaciones
        boolean activo
    }

    DEPOSITOS {
        int id PK
        int empresa_id FK
        string nombre
        string tipo
        int campo_id FK
    }

    STOCK {
        int id PK
        int deposito_id FK
        int producto_id FK
        float cantidad_actual
    }

    MOVIMIENTOS_STOCK {
        int id PK
        int deposito_id FK
        int producto_id FK
        string tipo
        float cantidad
        datetime fecha
        int usuario_id FK
        string referencia_tipo
        int referencia_id
        string observaciones
    }

    COMPRAS {
        int id PK
        int empresa_id FK
        int proveedor_id FK
        date fecha
        string numero_factura
        string moneda
        float cotizacion_usd
        float total_moneda_original
        float total_en_ars
        string archivo_factura_url
        string estado
        int creado_por FK
    }

    COMPRAS_ITEMS {
        int id PK
        int compra_id FK
        int producto_id FK
        int presentacion_id FK
        float cantidad_presentacion
        float cantidad_unidad_base
        float precio_unitario_moneda_original
        float precio_unitario_ars
        float subtotal_moneda_original
        float subtotal_ars
        int deposito_destino_id FK
        string numero_lote_proveedor
        date fecha_vencimiento
    }

    APLICACIONES {
        int id PK
        int campania_id FK
        date fecha
        string tipo
        string estado
        int usuario_id FK
        string observaciones
        boolean sincronizado
    }

    APLICACIONES_ITEMS {
        int id PK
