        int operario_id FK
        date fecha
        float horas_trabajadas
        string tipo_jornada
        float valor_hora_ars
        float costo_total_ars
        string observaciones
    }

    GASTOS_GENERALES {
        int id PK
        int empresa_id FK
        int unidad_negocio_id FK
        date fecha
        string categoria
        string descripcion
        string moneda
        float cotizacion_usd
        float monto_moneda_original
        float monto_ars
        string criterio_prorrateo
        int campania_id FK
        string archivo_comprobante_url
    }

    PERIODOS_CONTABLES {
        int id PK
        int empresa_id FK
        date fecha_desde
        date fecha_hasta
        string tipo
        string estado
        datetime fecha_cierre
        int cerrado_por FK
        datetime fecha_reapertura
        int reabierto_por FK
        string motivo_reapertura
        string observaciones
    }

    KPIS_SNAPSHOTS {
        int id PK
        int empresa_id FK
        int unidad_negocio_id FK
        date fecha
        string frecuencia
        float margen_bruto_acumulado_ars
        float costo_por_hectarea_promedio
        float stock_valorizado_ars
        float ventas_acumuladas_ars
        float produccion_acumulada_kg
        int campanias_activas
        int alertas_activas
        json kpis_extra
    }

    CONVERSACIONES_IA {
        int id PK
        int usuario_id FK
        int empresa_id FK
        string titulo
        datetime fecha_inicio
        datetime ultima_interaccion
        string estado
    }

    MENSAJES_IA {
        int id PK
        int conversacion_id FK
        string rol
        string contenido
        datetime fecha
        json contexto_datos
        int tokens_consumidos
    }

    REPORTES_PLANTILLAS {
        int id PK
        int empresa_id FK
        string nombre
        string descripcion
        string tipo
        string alcance
        json secciones
        string formato_salida
        int creado_por FK
        datetime fecha_creacion
        boolean activa
    }

    REPORTES_SUSCRIPCIONES {
        int id PK
        int plantilla_id FK
        int usuario_id FK
        string frecuencia
        string dia_envio
        string hora_envio
        json canales
        json filtros_aplicados
        boolean activa
        datetime ultima_ejecucion
    }

    REPORTES_GENERADOS {
        int id PK
        int plantilla_id FK
        int suscripcion_id FK
        datetime fecha_generacion
        date periodo_desde
        date periodo_hasta
        string archivo_url
        json destinatarios
        string estado
        string generado_por
        int tamaño_archivo
        string hash
    }

    ALERTAS_CONFIGURACION {
        int id PK
        int empresa_id FK
        string nombre
        string tipo_alerta
        json condicion
        json destinatarios
        json canales
        boolean activa
    }

    ALERTAS_DISPARADAS {
        int id PK
        int alerta_config_id FK
        datetime fecha
        string entidad_tipo
        int entidad_id
        json datos_contexto
        json usuarios_notificados
        string estado
    }

    ADJUNTOS {
        int id PK
        string entidad_tipo
        int entidad_id
        string tipo_archivo
        string url
        string descripcion
        int subido_por FK
        datetime fecha_subida
    }

    AUDITORIA {
        int id PK
        int empresa_id FK
        int usuario_id FK
        datetime fecha
        string entidad_tipo
        int entidad_id
        string accion
        json valores_anteriores
        json valores_nuevos
        string ip_origen
        int periodo_contable_id FK
    }
