    }

    MANTENIMIENTOS {
        int id PK
        int maquinaria_id FK
        date fecha
        string tipo
        string descripcion
        int proveedor_id FK
        string moneda
        float cotizacion_usd
        float costo_repuestos_ars
        float costo_mano_obra_ars
        float costo_servicio_externo_ars
        float costo_total_ars
        int horas_maquina_al_momento
        string archivo_factura_url
        int usuario_id FK
        string observaciones
    }

    LABORES {
        int id PK
        int campania_id FK
        string tipo_labor
        string modalidad
        date fecha
        float hectareas_trabajadas
        int maquinaria_id FK
        float horas_trabajadas
        float combustible_litros
        float costo_combustible_ars
        float costo_maquinaria_ars
        int contratista_id FK
        string unidad_facturacion
        float precio_unitario_facturacion
        float cantidad_facturada
        string moneda_contratista
        float cotizacion_usd_contratista
        float costo_contratista_moneda_original
        float costo_contratista_ars
        string numero_factura_contratista
        string archivo_factura_contratista_url
        float costo_materiales_ars
        float costo_mano_obra_ars
        float costo_total_ars
        int aplicacion_id FK
        int usuario_id FK
        string observaciones
    }

    LABORES_MATERIALES {
        int id PK
        int labor_id FK
        int producto_id FK
        int deposito_origen_id FK
        float cantidad_retirada
        float cantidad_usada
        float cantidad_devuelta
        float costo_unitario_ars_momento
        float costo_imputado_ars
    }

    LABORES_MANO_OBRA {
        int id PK
